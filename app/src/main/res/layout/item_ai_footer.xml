<?xml version="1.0" encoding="utf-8"?>
<layout>

    <androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:layout_marginBottom="16dp"
        android:padding="24dp"
        app:bindingRadius="@{@dimen/size32}"
        app:bindingStartColor="@{@color/primary}">

        <!-- Insight icon with white rounded bg -->
        <ImageView
            android:id="@+id/iv_ai_icon"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:padding="8dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_insights"
            app:bindingRadius="@{@dimen/size12}"
            app:bindingStartColor="@{@color/white}"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/primary" />

        <!-- AI Intelligence title -->
        <TextView
            android:id="@+id/tv_ai_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:fontFamily="sans-serif-medium"
            android:text="AI Intelligence"
            android:textColor="@android:color/white"
            android:textSize="18sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/iv_ai_icon"
            app:layout_constraintTop_toTopOf="@id/iv_ai_icon" />

        <!-- AI summary body -->
        <TextView
            android:id="@+id/tv_ai_summary_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="2dp"
            android:lineSpacingExtra="4dp"
            android:text="Your spending on Food has increased by 12% compared to last week. Most transactions were auto-parsed from your SMS receipts."
            android:textColor="#CCFFFFFF"
            android:textSize="14sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/iv_ai_icon"
            app:layout_constraintTop_toBottomOf="@id/tv_ai_title" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</layout>

