<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface"
    android:clipToPadding="false"
    android:fillViewport="true">

    <!-- Single vertical container for the whole form — no nesting inside -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="16dp"
        android:paddingBottom="100dp">

        <!-- ── Screen Title (dynamically set: "Add Expense" / "Edit Transaction") ── -->
        <TextView
            android:id="@+id/tv_screen_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:fontFamily="sans-serif-medium"
            android:text="Add Expense"
            android:textColor="@color/on_surface"
            android:textSize="22sp"
            android:textStyle="bold" />

        <!-- ── Amount ──────────────────────────────────────────────── -->
        <!-- amount_card: flat ConstraintLayout, removes the inner horizontal wrapper -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/amount_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="4dp"
            android:paddingTop="8dp"
            android:paddingBottom="16dp">

            <!-- "Enter Amount" label — centred horizontally -->
            <TextView
                android:id="@+id/tv_enter_amount_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif"
                android:letterSpacing="0.05"
                android:text="@string/enter_amount"
                android:textColor="@color/on_surface_variant"
                android:textSize="14sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <!-- Amount EditText — no wrapping LinearLayout needed -->
            <EditText
                android:id="@+id/et_amount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@android:color/transparent"
                android:cursorVisible="true"
                android:fontFamily="sans-serif-black"
                android:gravity="start|center_vertical"
                android:includeFontPadding="false"
                android:inputType="numberDecimal"
                android:minWidth="100dp"
                android:paddingTop="0dp"
                android:paddingBottom="0dp"
                android:textColor="@color/outline_variant"
                android:textSize="52sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tv_enter_amount_label" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- ── AI Badge ────────────────────────────────────────────── -->
        <!-- Single TextView instead of a LinearLayout wrapping two TextViews -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_category_unselected"
            android:paddingHorizontal="16dp"
            android:paddingVertical="6dp"
            android:text="✨  AI categorizing enabled"
            android:textColor="@color/secondary"
            android:textSize="12sp"
            android:textStyle="bold" />

        <!-- ── Category Section ────────────────────────────────────── -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:fontFamily="sans-serif-medium"
            android:text="@string/category"
            android:textColor="@color/on_surface"
            android:textSize="16sp"
            android:textStyle="bold" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_categories"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:clipToPadding="false"
            android:overScrollMode="never" />

        <!-- ── Transaction Date ────────────────────────────────────── -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:fontFamily="sans-serif-medium"
            android:text="@string/transaction_date"
            android:textColor="@color/on_surface"
            android:textSize="14sp"
            android:textStyle="bold" />

        <!-- Flat ConstraintLayout replaces the horizontal LinearLayout -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/date_picker_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_category_unselected"
            android:padding="16dp">

            <ImageView
                android:id="@+id/iv_date_icon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_history"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:tint="@color/on_surface_variant" />

            <TextView
                android:id="@+id/tv_selected_date"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="Select date"
                android:textColor="@color/on_surface"
                android:textSize="15sp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/iv_date_icon"
                app:layout_constraintTop_toTopOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- ── Payment Method ──────────────────────────────────────── -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:fontFamily="sans-serif-medium"
            android:text="@string/payment_method"
            android:textColor="@color/on_surface"
            android:textSize="14sp"
            android:textStyle="bold" />

        <!-- Flat ConstraintLayout with horizontal chain replaces weight-based LinearLayout -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp">

            <TextView
                android:id="@+id/chip_upi"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginEnd="4dp"
                android:background="@drawable/bg_category_selected"
                android:gravity="center"
                android:text="@string/upi"
                android:textColor="@color/primary"
                android:textSize="13sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toStartOf="@id/chip_cash"
                app:layout_constraintHorizontal_chainStyle="spread"
                app:layout_constraintHorizontal_weight="1"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/chip_cash"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginHorizontal="4dp"
                android:background="@drawable/bg_category_unselected"
                android:gravity="center"
                android:text="@string/cash"
                android:textColor="@color/on_surface_variant"
                android:textSize="13sp"
                app:layout_constraintEnd_toStartOf="@id/chip_card"
                app:layout_constraintHorizontal_weight="1"
                app:layout_constraintStart_toEndOf="@id/chip_upi"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/chip_card"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginStart="4dp"
                android:background="@drawable/bg_category_unselected"
                android:gravity="center"
                android:text="@string/card"
                android:textColor="@color/on_surface_variant"
                android:textSize="13sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_weight="1"
                app:layout_constraintStart_toEndOf="@id/chip_cash"
                app:layout_constraintTop_toTopOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- ── Note ────────────────────────────────────────────────── -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:fontFamily="sans-serif-medium"
            android:text="@string/note_optional"
            android:textColor="@color/on_surface"
            android:textSize="14sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/et_note"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_category_unselected"
            android:gravity="top|start"
            android:hint="@string/note_hint"
            android:inputType="textMultiLine"
            android:lines="3"
            android:padding="16dp"
            android:textColor="@color/on_surface"
            android:textColorHint="@color/outline"
            android:textSize="14sp" />

        <!-- ── Done Button ─────────────────────────────────────────── -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_done"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="32dp"
            android:backgroundTint="@color/primary"
            android:fontFamily="sans-serif-medium"
            android:text="@string/done"
            android:textColor="@android:color/white"
            android:textSize="16sp"
            android:textStyle="bold"
            app:cornerRadius="16dp"
            app:icon="@drawable/ic_add_circle"
            app:iconGravity="textStart"
            app:iconTint="@android:color/white" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
