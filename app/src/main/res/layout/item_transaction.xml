<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <!-- Variables defined but unused, state managed programmatically in adapter -->
    <data>
        <import type="android.view.View"/>
        <variable name="expense" type="com.smartexpense.ai.data.db.Expense" />
        <variable name="isExpanded" type="boolean" />
    </data>

    <!-- Root card: rounded-2xl (16dp) -->
    <LinearLayout
        android:id="@+id/layout_item_root"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:bindingRadius="@{@dimen/size16}"
        app:bindingStartColor="@{@color/surface_container_lowest}"
        android:layout_marginBottom="@dimen/size3"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- ── Row 1: Icon | Merchant+Subtitle | Amount+Badge+Arrow ── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Category icon circle -->
            <FrameLayout
                android:layout_width="48dp"
                android:layout_height="48dp">

                <View
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    app:bindingRadius="@{@dimen/size24}"
                    app:bindingStartColor="@{@color/surface_container_highest}" />

                <ImageView
                    android:id="@+id/iv_icon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_home"
                    app:tint="@color/primary" />
            </FrameLayout>

            <!-- Merchant + Subtitle -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tv_merchant"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:textColor="@color/on_surface"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <ImageView
                        android:id="@+id/iv_auto_sync_badge"
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:layout_marginStart="6dp"
                        android:src="@drawable/ic_insights"
                        app:tint="@color/on_tertiary_container"
                        android:visibility="gone" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tv_details"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="@color/outline"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Amount + auto-synced badge + expand chevron -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="end|center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:layout_marginEnd="12dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tv_amount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:textColor="@color/primary"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_auto_synced"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        app:bindingRadius="@{@dimen/size16}"
                        app:bindingStartColor="@{@color/surface_container_highest}"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="2dp"
                        android:text="AUTO-SYNCED"
                        android:textColor="@color/on_tertiary_container"
                        android:textSize="9sp"
                        android:fontFamily="sans-serif-medium"
                        android:textStyle="bold"
                        android:visibility="gone" />
                </LinearLayout>

                <!-- Expand/collapse chevron — always shown -->
                <ImageView
                    android:id="@+id/iv_expand_icon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_expand_more"
                    app:tint="@color/outline_variant" />
            </LinearLayout>
        </LinearLayout>

        <!-- ── Row 2: Note card — shown only when note exists ────── -->
        <!-- Collapsed → 1 line (italic preview)                      -->
        <!-- Expanded  → full text, multi-line                         -->
        <LinearLayout
            android:id="@+id/layout_note_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:bindingRadius="@{@dimen/size8}"
            app:bindingStartColor="@{@color/surface_container}"
            android:paddingHorizontal="12dp"
            android:paddingVertical="8dp"
            android:orientation="horizontal"
            android:gravity="top"
            android:visibility="gone">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginTop="1dp"
                android:layout_marginEnd="8dp"
                android:src="@drawable/ic_search"
                app:tint="@color/primary_fixed_dim" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="NOTE"
                    android:textColor="@color/outline_variant"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.08" />

                <!-- Note text — maxLines controlled by adapter (1=collapsed, unlimited=expanded) -->
                <TextView
                    android:id="@+id/tv_note_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/on_surface_variant"
                    android:textSize="13sp"
                    android:fontFamily="sans-serif"
                    android:textStyle="italic"
                    android:lineSpacingMultiplier="1.35" />
            </LinearLayout>
        </LinearLayout>

        <!-- ── Row 3: Meta grid — shown only when expanded ────────── -->
        <LinearLayout
            android:id="@+id/layout_meta_grid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:paddingTop="14dp"
            android:orientation="vertical"
            android:visibility="gone">

            <!-- Separator -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginBottom="14dp"
                android:background="#66C6C5D4" />

            <!-- 2-column meta grid -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:baselineAligned="false"
                android:paddingHorizontal="4dp">

                <!-- Left: Category + Date & Time -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="CATEGORY"
                        android:textColor="@color/outline"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif-medium"
                        android:letterSpacing="0.06" />

                    <TextView
                        android:id="@+id/tv_detail_category"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/on_surface"
                        android:textSize="14sp"
                        android:fontFamily="sans-serif-medium"
                        android:layout_marginTop="4dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="DATE &amp; TIME"
                        android:textColor="@color/outline"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif-medium"
                        android:letterSpacing="0.06"
                        android:layout_marginTop="16dp" />

                    <TextView
                        android:id="@+id/tv_detail_time"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/on_surface"
                        android:textSize="14sp"
                        android:fontFamily="sans-serif-medium"
                        android:layout_marginTop="4dp" />
                </LinearLayout>

                <!-- Right: Payment Method + Sync Status -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="end"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="PAYMENT METHOD"
                        android:textColor="@color/outline"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif-medium"
                        android:letterSpacing="0.06" />

                    <TextView
                        android:id="@+id/tv_detail_payment_method"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/on_surface"
                        android:textSize="14sp"
                        android:fontFamily="sans-serif-medium"
                        android:layout_marginTop="4dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="SYNC STATUS"
                        android:textColor="@color/outline"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif-medium"
                        android:letterSpacing="0.06"
                        android:layout_marginTop="16dp" />

                    <TextView
                        android:id="@+id/tv_detail_sync_status"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/on_tertiary_container"
                        android:textSize="11sp"
                        android:fontFamily="sans-serif-medium"
                        android:textStyle="bold"
                        android:layout_marginTop="4dp" />
                </LinearLayout>
            </LinearLayout>

            <!-- ── Separator ── -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="14dp"
                android:background="#33C6C5D4" />

            <!-- ── Edit Transaction Button ── -->
            <LinearLayout
                android:id="@+id/btn_edit_transaction"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="4dp">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_edit"
                    app:tint="@color/primary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.04"
                    android:text="EDIT TRANSACTION"
                    android:textColor="@color/primary"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

        </LinearLayout>
    </LinearLayout>

</layout>
